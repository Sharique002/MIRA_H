# MIRA-H Environment Configuration Template

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=replace-with-your-own-random-secret-key

# Backend API Configuration
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (SQLite default, PostgreSQL optional)
DATABASE_URL=sqlite:///./mirah.db
# DATABASE_URL=postgresql://mirah_user:mirah_pass@localhost:5432/mirah_db

# Frontend Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_ENABLE_LOCAL_VISION=true

# Vision & Landmark Limits
MAX_FRAME_RATE=30
FRAME_QUEUE_LIMIT=10
MIN_DETECTION_CONFIDENCE=0.65
MIN_TRACKING_CONFIDENCE=0.65
